# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,api.localhost,.ems.incelgroup.com

# Database (PostgreSQL) — configured in Prompt 2 with django-tenants
# Host 5432 is often busy; local docker maps DB_PORT (default 5433) → container 5432.
DB_NAME=ems
DB_USER=ems
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Payments
# Single platform-level secret key (sk_test_... locally). No per-school keys.
PAYSTACK_SECRET_KEY=
# Local Bruno / HMAC fixtures only (ignored unless DEBUG=True). Lets
# signed webhooks apply without a live sk_test_ card flow. Leave False
# when exercising real Paystack test-mode.
PAYSTACK_STUB_GATEWAY=False
# Percent of each online payment retained by the platform (Paystack
# subaccount percentage_charge). Platform-wide; not settable per school.
PLATFORM_COMMISSION_PCT=5.00

# Observability
SENTRY_DSN=

# JWT refresh cookie (httpOnly). Production must use Secure=True (HTTPS).
# Local: LOCAL_CROSS_SITE_COOKIES=True (default in local.py) forces Secure +
# SameSite=None so platform.localhost / school *.localhost can call localhost:8000.
# Set LOCAL_CROSS_SITE_COOKIES=False to use plain AUTH_COOKIE_SECURE below.
LOCAL_CROSS_SITE_COOKIES=True
AUTH_COOKIE_SECURE=False

# CSRF trusted origins for cookie-based refresh/logout (comma-separated).
# Django 5 accepts subdomain wildcards: http://*.localhost:3000, https://*.yourapp.com
# Platform UI (local): http://platform.localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://*.localhost:3000,http://platform.localhost:3001,http://*.localhost:3001

# Readable CSRF cookie on a parent domain so the SPA on a school subdomain
# can send X-CSRFToken. Empty = host-only (Bruno / same-host clients).
# Production example: CSRF_COOKIE_DOMAIN=.yourapp.com
CSRF_COOKIE_DOMAIN=

# CORS allowlist for the Next.js SPA (comma-separated origins, no trailing slash).
# Production MUST set this (and/or CORS_ALLOWED_ORIGIN_REGEXES) and keep
# CORS_ALLOW_ALL_ORIGINS=False (hardcoded in production.py).
# Local defaults to CORS_ALLOW_ALL_ORIGINS=True; set False to exercise this list.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://platform.localhost:3001
CORS_ALLOWED_ORIGIN_REGEXES=^http://[\w-]+\.localhost:3000$,^http://[\w-]+\.localhost:3001$
CORS_ALLOW_ALL_ORIGINS=True

# Refresh cookie. Leave Domain empty (host-only on the API host). SameSite=Strict
# works when SPA and API are same-site (*.yourapp.com). Local cross-site
# (testacademy.localhost → localhost) will not send the cookie.
AUTH_REFRESH_COOKIE_SAMESITE=Strict
AUTH_COOKIE_DOMAIN=

# Invite / parent links point at the frontend subdomain, not the API host.
TENANT_FRONTEND_ORIGIN_TEMPLATE=http://{slug}.localhost:3000
TENANT_FRONTEND_SCHEME=http
TENANT_FRONTEND_PORT=3000

	# Login + refresh throttle (DRF scope "auth"). Starting value, not final.
AUTH_THROTTLE_RATE=5/min

# Email. config.settings.local always prints to the console.
# Production uses Django's generic SMTP backend (no provider SDK).
# Set a host when you pick a provider. Do not commit real credentials.
# Use TLS on 587 or SSL on 465, not both.
DEFAULT_FROM_EMAIL=noreply@ems.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=30
STAFF_INVITE_EXPIRY_DAYS=7
STAFF_INVITE_ACCEPT_PATH=/accept-invite

# WhatsApp Cloud API (Graph). No BSP SDK.
# config.settings.local always prints the template to the console.
# Production default is WHATSAPP_BACKEND=cloud. Submit the three Utility
# templates in communications/whatsapp_templates.py before sending for real.
# Do not commit a real token.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_TIMEOUT=30
# Pair limit: 1 message per recipient per 6 seconds (error 131056).
# WHATSAPP_PAIR_INTERVAL_SECONDS=6
