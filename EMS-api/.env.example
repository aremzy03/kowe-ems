# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.ems.incelgroup.com

# Database (PostgreSQL) — configured in Prompt 2 with django-tenants
# Host 5432 is often busy; local docker maps DB_PORT (default 5433) → container 5432.
DB_NAME=ems
DB_USER=ems
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Payments
PAYSTACK_SECRET_KEY=

# Observability
SENTRY_DSN=

# JWT refresh cookie (httpOnly). Production must use Secure=True (HTTPS).
# Local HTTP: leave False so the cookie is set on http://localhost.
AUTH_COOKIE_SECURE=False

# CSRF trusted origins for cookie-based refresh/logout (comma-separated).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS allowlist for the Next.js SPA (comma-separated origins, no trailing slash).
# Production MUST set this and keep CORS_ALLOW_ALL_ORIGINS=False (hardcoded in production.py).
# Local defaults to CORS_ALLOW_ALL_ORIGINS=True; set False to exercise this list.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True

# Login + refresh throttle (DRF scope "auth"). Starting value, not final.
AUTH_THROTTLE_RATE=5/min

# Email (local.py forces console backend; set SMTP vars in production)
DEFAULT_FROM_EMAIL=noreply@ems.local
STAFF_INVITE_EXPIRY_DAYS=7
STAFF_INVITE_ACCEPT_PATH=/accept-invite
