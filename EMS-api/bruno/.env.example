# Copy to .env (gitignored). Used via {{process.env.VAR}} in requests.
ADMIN_EMAIL=admin@testacademy.local
ADMIN_PASSWORD=ChangeMe123!
# Base32 TOTP secret for an already-enrolled admin (from enroll response or DB).
# Required for Auth/01 Login Admin → 2FA Verify path when enrollment_required is false.
ADMIN_TOTP_SECRET=
# Optional overrides for invited staff / parent emails (defaults use timestamps).
# STAFF_INVITE_EMAIL=
# PARENT_EMAIL=
# PARENT_PASSWORD=ParentPass123!

# HMAC-SHA512 for Finance webhook requests. Must match the Django process
# PAYSTACK_SECRET_KEY. For local fixtures without a live sk_test_ key use:
# PAYSTACK_SECRET_KEY=sk_test_bruno_local_hmac
# (and start Django with PAYSTACK_STUB_GATEWAY=True).
PAYSTACK_SECRET_KEY=sk_test_bruno_local_hmac
