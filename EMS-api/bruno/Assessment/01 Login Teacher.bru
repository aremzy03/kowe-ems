meta {
  name: 01 Login Teacher
  type: http
  seq: 1
  tags: [
    assessment
    smoke
    phase2
  ]
}

post {
  url: {{baseUrl}}/api/auth/login/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{staffInviteEmail}}",
    "password": "{{staffInvitePassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.access) {
    bru.setEnvVar("teacherAccessToken", res.body.access);
  }
}

assert {
  res.status: eq 200
  res.body.requires_2fa: eq false
  res.body.role: eq teacher
  res.body.access: isDefined
}
