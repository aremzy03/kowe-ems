meta {
  name: 02 Create ClassSubjectAssignment
  type: http
  seq: 2
  tags: [
    assessment
    smoke
    phase2
  ]
}

post {
  url: {{baseUrl}}/api/academics/class-subject-assignments/
  body: json
  auth: none
}

headers {
  Host: {{tenantHost}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "teacher": "{{teacherUserId}}",
    "subject": "{{subjectId}}",
    "class_level": "{{classLevelId}}",
    "arm": "{{armId}}",
    "term": "{{termId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("assignmentId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.teacher: isDefined
  res.body.subject: isDefined
}
