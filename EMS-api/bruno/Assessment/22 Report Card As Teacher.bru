meta {
  name: 22 Report Card As Teacher
  type: http
  seq: 22
  tags: [
    assessment
    smoke
    phase2
    report-card
  ]
}

get {
  url: {{baseUrl}}/api/assessment/report-cards/?student={{studentId}}&term={{termId}}
  body: none
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Accept: */*
  Authorization: Bearer {{teacherAccessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("assigned teacher can download student report card PDF", function () {
    expect(res.getStatus()).to.equal(200);
    const ct = res.getHeader("content-type") || res.getHeader("Content-Type") || "";
    expect(String(ct)).to.match(/application\/pdf/i);
  });
}
