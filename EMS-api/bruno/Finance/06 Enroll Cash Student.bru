meta {
  name: 06 Enroll Cash Student
  type: http
  seq: 6
  tags: [
    finance
    smoke
    phase4
  ]
}

post {
  url: {{baseUrl}}/api/academics/enrollments/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "student": "{{cashStudentId}}",
    "class_level": "{{classLevelId}}",
    "arm": "{{armId}}",
    "session": "{{sessionId}}",
    "term": "{{termId}}",
    "status": "active"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("cashEnrollmentId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.status: eq active
}
