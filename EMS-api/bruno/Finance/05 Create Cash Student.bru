meta {
  name: 05 Create Cash Student
  type: http
  seq: 5
  tags: [
    finance
    smoke
    phase4
  ]
}

post {
  url: {{baseUrl}}/api/academics/students/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "first_name": "Cash",
    "last_name": "Bruno",
    "date_of_birth": "2014-06-01",
    "gender": "male",
    "admission_number": "{{cashAdmissionNumber}}",
    "admission_date": "2026-09-01",
    "guardian": {
      "full_name": "Cash Guardian",
      "phone_number": "+2348098765432",
      "relationship_to_student": "father",
      "is_primary_contact": true
    }
  }
}

script:pre-request {
  const stamp = Date.now().toString(36).toUpperCase();
  bru.setEnvVar("cashAdmissionNumber", `ADM-CASH-${stamp}`);
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("cashStudentId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

tests {
  test("cash student is not the linked parent child", function () {
    expect(bru.getEnvVar("cashStudentId")).to.not.equal(bru.getEnvVar("studentId"));
  });
}
