meta {
  name: 10 Parent Report Card After Publish
  type: http
  seq: 10
  tags: [
    communications
    smoke
    phase5
    parents
    report-card
  ]
}

get {
  url: {{baseUrl}}/api/assessment/report-cards/?student={{studentId}}&term={{termId}}
  body: none
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Accept: */*
  Authorization: Bearer {{parentAccessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("linked parent can download the PDF after publish", function () {
    expect(res.getStatus()).to.equal(200);
    const ct = res.getHeader("content-type") || res.getHeader("Content-Type") || "";
    expect(String(ct)).to.match(/application\/pdf/i);
    const cd = res.getHeader("content-disposition") || res.getHeader("Content-Disposition") || "";
    expect(String(cd)).to.match(/attachment/i);
  });
}
