meta {
  name: 22 Term Summary Parent Unlinked Denied
  type: http
  seq: 22
  tags: [
    attendance
    smoke
    phase3
    rbac
  ]
}

get {
  url: {{baseUrl}}/api/attendance/summaries/student/?student={{attendanceUnlinkedStudentId}}&term={{termId}}
  body: none
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Accept: application/json
  Authorization: Bearer {{parentAccessToken}}
}

assert {
  res.status: eq 400
}

tests {
  test("parent cannot view attendance summary for unlinked student", function () {
    expect(res.getStatus()).to.equal(400);
    const blob = JSON.stringify(res.getBody());
    expect(blob).to.match(/link|linking code|verified/i);
  });
}
