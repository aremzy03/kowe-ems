meta {
  name: 13 Create Unassigned Arm
  type: http
  seq: 13
  tags: [
    attendance
    smoke
    phase3
    rbac
  ]
}

post {
  url: {{baseUrl}}/api/academics/arms/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "class_level": "{{classLevelId}}",
    "name": "B-Unassigned"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("unassignedArmId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

tests {
  test("unassigned arm exists for class-teacher RBAC negative", function () {
    expect(bru.getEnvVar("unassignedArmId")).to.be.a("string");
    expect(bru.getEnvVar("unassignedArmId")).to.not.equal(bru.getEnvVar("armId"));
  });
}
