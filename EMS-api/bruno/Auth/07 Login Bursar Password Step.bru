meta {
  name: 07 Login Bursar Password Step
  type: http
  seq: 7
  tags: [
    auth
    phase1
    2fa
  ]
}

post {
  url: {{baseUrl}}/api/auth/login/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{bursarEmail}}",
    "password": "{{bursarPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body) {
    if (res.body.pre_auth_token) {
      bru.setEnvVar("bursarPreAuthToken", res.body.pre_auth_token);
      bru.setEnvVar("preAuthToken", res.body.pre_auth_token);
    }
    bru.setEnvVar("bursarEnrollmentRequired", String(!!res.body.enrollment_required));
  }
}

assert {
  res.status: eq 200
  res.body.requires_2fa: eq true
  res.body.enrollment_required: eq true
  res.body.role: eq bursar
  res.body.pre_auth_token: isDefined
}
