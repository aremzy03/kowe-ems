meta {
  name: 03 My Students Before Redeem
  type: http
  seq: 3
  tags: [
    parents
    smoke
    phase1
  ]
}

get {
  url: {{baseUrl}}/api/academics/my-students/
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Accept: application/json
  Authorization: Bearer {{parentAccessToken}}
}

assert {
  res.status: eq 200
  res.body.count: eq 0
  res.body.results: isArray
}

tests {
  test("no student PII before linking-code redemption", function () {
    const body = res.getBody();
    expect(body.count).to.equal(0);
    expect(body.results).to.deep.equal([]);
  });
}
