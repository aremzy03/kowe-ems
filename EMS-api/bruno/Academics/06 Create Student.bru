meta {
  name: 06 Create Student
  type: http
  seq: 6
  tags: [
    academics
    smoke
    phase1
  ]
}

post {
  url: {{baseUrl}}/api/academics/students/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "first_name": "Ada",
    "last_name": "Bruno",
    "date_of_birth": "2014-03-15",
    "gender": "female",
    "admission_number": "{{admissionNumber}}",
    "admission_date": "2026-09-01",
    "guardian": {
      "full_name": "Guardian Bruno",
      "phone_number": "+2348012345678",
      "relationship_to_student": "mother",
      "is_primary_contact": true
    }
  }
}

script:pre-request {
  const stamp = Date.now().toString(36).toUpperCase();
  bru.setEnvVar("admissionNumber", `ADM-BRU-${stamp}`);
}

script:post-response {
  if (res.status === 201 && res.body) {
    if (res.body.id) {
      bru.setEnvVar("studentId", res.body.id);
    }
    if (res.body.linking_code) {
      bru.setEnvVar("linkingCode", res.body.linking_code);
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.linking_code: isDefined
}
