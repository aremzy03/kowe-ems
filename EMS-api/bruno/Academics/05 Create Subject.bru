meta {
  name: 05 Create Subject
  type: http
  seq: 5
  tags: [
    academics
    smoke
    phase1
  ]
}

post {
  url: {{baseUrl}}/api/academics/subjects/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Mathematics",
    "code": "{{subjectCode}}"
  }
}

script:pre-request {
  const stamp = Date.now().toString(36).toUpperCase().slice(-6);
  bru.setEnvVar("subjectCode", `MTH${stamp}`);
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("subjectId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: eq Mathematics
}
