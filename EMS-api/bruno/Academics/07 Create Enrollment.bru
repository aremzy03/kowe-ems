meta {
  name: 07 Create Enrollment
  type: http
  seq: 7
  tags: [
    academics
    smoke
    phase1
  ]
}

post {
  url: {{baseUrl}}/api/academics/enrollments/
  body: json
  auth: none
}

headers {
  X-Tenant-Slug: {{tenantSlug}}
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "student": "{{studentId}}",
    "class_level": "{{classLevelId}}",
    "arm": "{{armId}}",
    "session": "{{sessionId}}",
    "term": "{{termId}}",
    "status": "active"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("enrollmentId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.status: eq active
}
